class Solution {
  public:
    int getSecondLargest(vector<int> &arr) {
        // code here
        int mx=INT_MIN;
        for(int i=0; i<arr.size(); i++){
            if(arr[i]>=mx) mx=arr[i];
        }
        
        int smx=INT_MIN;
        for(int i=0; i<arr.size(); i++){
            if(arr[i]>=smx && arr[i]!=mx) smx=arr[i];
        }
        if(smx==INT_MIN){  //if second max doesnot exist
            return -1;
        }
        return smx;
    }
};
