class Solution {
public:
    int search(vector<int>& nums, int target) {
        // int n=nums.size();
        // int m=nums[n/2];
        // int k=n/2;
        // if(m>target){
        //     for(int i=0; i<k; i++){
        //        if(nums[i]==target) return i;
        //     }
        // }else{
        //     for(int i=k+1; i<n; i++){
        //         if(nums[i]==target) return i;
        //     }
            
        // }
        // if(nums[n/2]==target) return n/2;

        // return -1;

        int n=nums.size();
        int h=n-1;
        int l=0;
        
        while(l<=h){
        int mid=(h+l)/2;
            if(nums[mid]>target){ 
                h=mid-1;
            }else if(nums[mid]<target) {
                l=mid+1;
                }else {
                    return mid;
                }
            
            
        }
        return -1;
    }
};

// TC=O(log(n))
