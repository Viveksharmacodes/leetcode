class Solution {
  public:
    void reverseArray(vector<int> &arr) {
        // code here
        int n=arr.size();
        int m=n/2;
        for(int i=0; i<m; i++){
            int temp=arr[n-i-1];
            arr[n-i-1]=arr[i];
            arr[i]=temp;
    }
    
    }
};

