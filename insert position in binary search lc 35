class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int n=nums.size();
        int l=0, h=n-1;
        int k;
        
        while(l<=h){
            int mid=(l+h)/2;
            if(nums[mid]>target) h= mid-1;
            else if(nums[mid]<target) l=mid+1;
            else  return mid;
            k=mid;
    }
    // if(target>nums[k]) return k+1;   
    // else return k;     
     // }
    return l;
    }
};
