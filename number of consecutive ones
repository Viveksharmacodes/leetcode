class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int n=nums.size();
        vector<int> arr;
        int k=0;
       for(int i=0; i<n; i++){
        if(nums[i]==1) k++;
        if(nums[i]==0 || i==n-1) { // second case when nums not end with 0
            arr.push_back(k);
            k=0;
            }
       }
    //    arr.push_back(k); //if nums not end with zero
        int max=INT_MIN;
        for(int j=0; j<arr.size(); j++){
            if(arr[j]>max) max=arr[j];
        }
        return max;
    }
};
